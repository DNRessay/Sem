# Copy to .env for local dev. In AWS these are set via template.yaml
# parameters, filled in from GitHub Actions secrets on deploy — never commit
# real values here.

# Groq — free tier, open-weight models only (no vendor spoofing)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_PLANNING_MODEL=openai/gpt-oss-120b

# Neon serverless Postgres (+ pgvector) — replaces MySQL and ChromaDB
NEON_DATABASE_URL=postgresql://user:pass@host/semblance?sslmode=require

# Modal embeddings endpoint (modal_app/embeddings.py) — blank = deterministic
# fallback vector, fine for local dev, not semantically meaningful
MODAL_EMBEDDINGS_URL=

# DynamoDB cache table — only used when AWS credentials are present;
# falls back to in-memory-only caching otherwise
CACHE_TABLE_NAME=semblance-cache
AWS_REGION=us-east-1

# Optional tools
SERP_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
GOOGLE_CALENDAR_CREDS=./creds/google.json
OPENCLAW_URL=

SECRET_KEY=change-me
TRUST_MODE=AUTO
