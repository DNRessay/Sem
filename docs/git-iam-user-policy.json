{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CFN",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:*:053097418755:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:*:053097418755:stack/semblance/*"
      ]
    },
    {
      "Sid": "S3",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::aws-sam-cli-managed-default*",
        "arn:aws:s3:::aws-sam-cli-managed-default*/*"
      ]
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:*:053097418755:function:semblance-*"
    },
    {
      "Sid": "IAMRoles",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::053097418755:role/semblance-*"
    },
    {
      "Sid": "DynamoDB",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:*:053097418755:table/semblance-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:*:053097418755:log-group:/aws/lambda/semblance-*"
    },
    {
      "Sid": "Events",
      "Effect": "Allow",
      "Action": "events:*",
      "Resource": "arn:aws:events:*:053097418755:rule/semblance-*"
    }
  ]
}
